# Database — Supabase Postgres
# Get your connection string from Supabase Dashboard > Project Settings > Database > Connection string > URI
DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres"

# Supabase project reference (for Supabase client if needed later)
NEXT_PUBLIC_SUPABASE_URL="https://[YOUR-PROJECT-REF].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="[YOUR-ANON-KEY]"

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# NOTE: Do NOT set NODE_ENV here. Next.js sets it automatically for
# `next dev` (development) and `next build`/`next start` (production).
# Setting it in .env breaks `next build` (React becomes null at build time).

# Object Storage (for raw documents — S3-compatible)
# STORAGE_ENDPOINT="https://[YOUR-PROJECT-REF].supabase.co/storage/v1/s3"
# STORAGE_ACCESS_KEY="[YOUR-ACCESS-KEY]"
# STORAGE_SECRET_KEY="[YOUR-SECRET-KEY]"
# STORAGE_BUCKET="raw-documents"
# STORAGE_REGION="us-east-1"

# Redis (for background job queue — optional for MVP)
# REDIS_URL="redis://localhost:6379"

# Finnhub — free company-news endpoint (news-count signal for ignored-score)
# Get a free key at https://finnhub.io (60 calls/min on the free tier)
FINNHUB_API_KEY="[YOUR-FINNHUB-KEY]"

# Email (transactional — optional for MVP)
# SMTP_HOST=""
# SMTP_PORT="587"
# SMTP_USER=""
# SMTP_PASS=""
# EMAIL_FROM="alerts@hiddencatalyst.com"

# SEC EDGAR — required User-Agent (SEC rejects requests without a valid contact email)
SEC_USER_AGENT="Hidden Catalyst Research contact@hiddencatalyst.com"
